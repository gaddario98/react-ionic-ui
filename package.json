{
  "name": "@gaddario98/react-ionic-ui",
  "version": "1.0.23",
  "type": "module",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "license": "MIT",
  "files": [
    "dist",
    "styles"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.js && rollup -c rollup.dts.config.js",
    "prepublishOnly": "yarn build"
  },
  "devDependencies": {
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/rollup-plugin-peer-deps-external": "^2",
    "babel-plugin-react-compiler": "1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rollup": "^4.40.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@gaddario98/react-auth": "^1.0.16",
    "@gaddario98/react-ionic-utiles": "^1.0.2",
    "@gaddario98/react-localization": "^1.0.17",
    "@gaddario98/react-notifications": "^1.0.17",
    "@gaddario98/react-queries": "^1.0.21",
    "@gaddario98/react-state": "^1.0.15"
  },
  "peerDependencies": {
    "@capacitor/core": "*",
    "@ionic/react": "*",
    "@mapbox/search-js-react": "*",
    "@tailwindcss/cli": "^4.1.3",
    "@tailwindcss/postcss": "^4.1.3",
    "@tanstack/react-query": "*",
    "@tanstack/react-table": "*",
    "i18next": "*",
    "mapbox-gl": "*",
    "postcss": "^8.5.3",
    "react": ">=18.0.0 <20.0.0",
    "react-i18next": "*",
    "tailwindcss": "^4.1.3"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.mjs"
    },
    "./components": {
      "types": "./dist/types/components.d.ts",
      "import": "./dist/esm/components.mjs",
      "require": "./dist/cjs/components.js",
      "default": "./dist/esm/components.mjs"
    },
    "./hooks": {
      "types": "./dist/types/hooks.d.ts",
      "import": "./dist/esm/hooks.mjs",
      "require": "./dist/cjs/hooks.js",
      "default": "./dist/esm/hooks.mjs"
    },
    "./styles": {
      "types": "./dist/types/styles.d.ts",
      "import": "./dist/esm/styles.mjs",
      "require": "./dist/cjs/styles.js",
      "default": "./dist/esm/styles.mjs"
    },
    "./styles/input.css": "./styles/input.css"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/gaddario98/react-ionic-ui"
  },
  "keywords": [
    "react-ionic",
    "ionic",
    "react",
    "ui",
    "components",
    "gaddario98"
  ],
  "author": "Giosuè Addario",
  "bugs": {
    "url": "https://github.com/gaddario98/react-ionic-ui/issues"
  },
  "homepage": "https://github.com/gaddario98/react-ionic-ui#readme"
}
